{
  "buildCommand": "npm install",
  "outputDirectory": ".",
  "public": ".",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/dashboard",
      "destination": "dashboard.html"
    },
    {
      "source": "/dashboard.html",
      "destination": "dashboard.html"
    }
  ],
  "functions": {
    "api/*.js": {
      "memory": 128,
      "maxDuration": 10
    }
  }
}